APP_URL=http://localhost
# Backend's own publicly reachable base URL (used to build uploaded-file URLs).
# Differs from APP_URL when the backend is deployed under a subfolder, e.g.
# https://example.com/Backend while APP_URL (frontend) is https://example.com
BACKEND_PUBLIC_URL=http://localhost:8090
JWT_SECRET=replace-with-a-secure-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ABC12345678abc
DB_NAME=the_florist
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# MercadoPago: usar token TEST- para sandbox, APP_USR- para producción
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-0000000000
MERCADOPAGO_WEBHOOK_SECRET=
